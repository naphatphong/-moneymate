# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงของคุณ
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SESSION_SECRET=ใส่ข้อความลับยาว-ๆ-สุ่ม-ๆ-ตรงนี้
NODE_ENV=development
PORT=3000

# ----- ลืมรหัสผ่าน: ส่งลิงก์ทางอีเมลผ่าน Brevo (https://www.brevo.com ฟรีวันละ 300 ฉบับ) -----
# ถ้าไม่ใส่ตอน development ลิงก์จะถูกพิมพ์ออกทาง console ของเซิร์ฟเวอร์แทน
# ตอนใช้งานจริง (NODE_ENV=production) ต้องใส่ครบทั้ง 3 ค่า
BREVO_API_KEY=
# อีเมลผู้ส่ง ต้องยืนยัน (verify) ใน Brevo ก่อน: Senders, Domains & Dedicated IPs > Senders
MAIL_FROM=
MAIL_FROM_NAME=MoneyMate
# ที่อยู่เว็บจริง ใช้สร้างลิงก์ในอีเมล และ redirect ของ Google เช่น https://moneymate.onrender.com
APP_URL=

# ----- เข้าสู่ระบบด้วย Google (ถ้าไม่ใส่ ปุ่ม Google จะถูกซ่อน) -----
# สร้างที่ https://console.cloud.google.com > APIs & Services > Credentials > Create credentials
#   > OAuth client ID > Web application แล้วใส่ Authorized redirect URIs:
#     https://<ที่อยู่เว็บจริง>/auth/google/callback
#     http://localhost:3000/auth/google/callback   (สำหรับทดสอบในเครื่อง)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- ผู้ช่วย AI ด้วย Google Gemini (ถ้าไม่ใส่ ฟีเจอร์ AI ทั้งหมดจะถูกซ่อน) -----
# สร้างคีย์ฟรีที่ https://aistudio.google.com > Get API key (ไม่ต้องผูกบัตร)
# หมายเหตุ: แพลนฟรี Google อาจนำข้อมูลที่ส่งไปใช้ปรับปรุงบริการ — ผู้ใช้ต้องกดยินยอมก่อนใช้ทุกคน
GEMINI_API_KEY=
# (ไม่บังคับ) รุ่นที่ใช้ ถ้าไม่ใส่จะใช้ Flash-Lite รุ่นล่าสุด (โควตาฟรีต่อวันมากที่สุด)
GEMINI_MODEL=
# (ไม่บังคับ) จำนวนครั้งที่เรียก AI ได้ต่อผู้ใช้ต่อวัน (ค่าเริ่มต้น 30)
AI_DAILY_LIMIT=30
# (ไม่บังคับ) ใส่ true เมื่อเปิดบิลในโปรเจกต์ Gemini แล้ว ข้อความขอความยินยอมจะไม่บอกว่าเป็นแพลนฟรี
GEMINI_PAID_TIER=false
